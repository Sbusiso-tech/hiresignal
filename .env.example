# Copy to .env and adjust. Everything works without API keys (Himalayas, Jobicy,
# Remotive and Arbeitnow are free public APIs); add keys to unlock more sources.

# --- Job sources --------------------------------------------------------------
JOB_SOURCES=himalayas,jobicy,remotive,arbeitnow,adzuna,jsearch,partner_sftp
SEARCH_TERMS=data engineer,data analyst,data scientist,software engineer,python developer,devops engineer,machine learning engineer
HIMALAYAS_MAX_PAGES=5
ARBEITNOW_MAX_PAGES=5

# Adzuna (free key, has South Africa): https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=za,gb,us
ADZUNA_MAX_PAGES=3

# JSearch on RapidAPI (free tier ~200 requests/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
JSEARCH_LOCATION=South Africa
JSEARCH_COUNTRY=za
JSEARCH_NUM_PAGES=1

# Partner SFTP drop (the sftp service in docker-compose.yml; `make partner-drop` simulates a delivery)
SFTP_USER=partner
SFTP_PASSWORD=partner

# --- Infrastructure (defaults match docker-compose.yml) -------------------------
POSTGRES_USER=jobmarket
POSTGRES_PASSWORD=jobmarket
POSTGRES_DB=jobmarket
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
LAKE_BUCKET=jobs-lake

# group id of /var/run/docker.sock on the host (lets Airflow launch task containers)
DOCKER_GID=999
